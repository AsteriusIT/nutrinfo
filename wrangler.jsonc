// Un seul Worker : le site statique pré-rendu + l'assistant (/api/chat).
// Clé d'API : `npx wrangler secret put ANTHROPIC_API_KEY` (jamais dans ce fichier).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asterius-nutrition",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Les fichiers statiques sont servis sans réveiller le Worker, sauf l'API
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CLAUDE_MODEL": "claude-opus-5-5"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      // 10 questions par minute et par adresse IP
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
